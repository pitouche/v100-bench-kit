# ============================================================================
# kit.env — configuration explicite du kit V100
#
# Utilisation :
#   cp config/kit.env.example config/kit.env
#   # éditer config/kit.env pour la machine cible
#
# Les scripts du kit (bench harnais, builds e2) lisent ces variables.
# Ce qui est MACHINE-DÉPENDANT (chemins GGUF, libs, service systemd, toolchain)
# DOIT être défini ici. Ce qui est REPO-DÉPENDANT a un défaut relatif au repo.
#
# ⚠️ Le kit ne contient AUCUN secret. Si un script demande un token
# (superviseur OWUI), il le lit d'un fichier de permissions 0600
# (cf. docs/protocols/01-superviseur-bench.md).
# ============================================================================

# --- Racine du kit (défaut : le dossier parent de config/) ------------------
: "${KIT_ROOT:=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)}"

# --- Machine / GPU -----------------------------------------------------------
# ⚠️ Piège documenté (h2/PROTOCOLE.md) : l'ordre CUDA != l'ordre nvidia-smi.
# Sur la machine de référence : nvidia-smi -L -> 0: V100, 1: GTX 1070,
# mais CUDA : cuda:0 = V100, cuda:1 = 1070. VÉRIFIER avec un probe cuDeviceGet*
# avant tout run (cf. run/v100probe de la machine de référence).
V100_SM_INDEX=1            # index nvidia-smi de la V100 (memory.used queries)
CUDA_VISIBLE_DEVICES_V100=0   # index CUDA de la V100 (à vérifier, cf. piège)

# --- Service Ollama V100 (stoppé/restauré par les A/B) ------------------------
OLLAMA_SERVICE=ollama-v100
PROD_PORT=11434
CAPTURE_PORT=44911         # port du serveur de capture (NTOUCHE PAS la prod)
CAPTURE_PORT_ALT=44901     # port alt (h2_capture.sh / run7)

# --- Modèle -------------------------------------------------------------------
MODEL_TAG=qwen3.8-27b-q6-mtp:latest
# Blob GGUF de référence : 23 088 409 504 octets, sha256 ci-dessous.
# Adapter le chemin à votre installation Ollama.
MODEL_GGUF=/usr/share/ollama/.ollama/models/blobs/sha256-493301830a596b8ad56dc1329f80bbcb578c8e910da395feafdc9cd8263430bb
MODEL_GGUF_SIZE=23088409504

# --- Kernels custom (env du serveur de capture — parité prod) -----------------
# (cf. SYNTHSE §2 : kernels actifs dans le .so prod)
ENV_GGML_CUDA_VOLTA_Q6_W4R4=1
# Env de la shortlist head MTP (131 072 lignes, couverture 99,2 %).
# Fichier binaire à fournir séparément (voir docs/HISTORIQUE.md §reproduction).
ENV_GGML_CUDA_QWEN35_MTP_SHORTLIST=${KIT_ROOT}/h2/data/qwen38-27b-exact-131072.i32
ENV_LLAMA_ARG_SPEC_MTP_DEFER_PROMPT=1

# --- Libraries sous test (A/B H2 / H2b / REF) ---------------------------------
# REF  : backup du .so prod known-good (md5 e4afbb4a...)
# H2   : libggml-cuda-h2.so  (md5 a4b6f440...) — dans bigfiles/ (hors git)
# H2b  : libggml-cuda-h2b.so (md5 0eb5afbd...) — dans bigfiles/ (hors git)
# DEPLOYED : le .so en production — JAMAIS modifié par le kit
REF_LIB=/var/backups/llama-experiments/libggml-cuda.so.prod-20261014-134252
H2_LIB=${KIT_ROOT}/bigfiles/libggml-cuda-h2.so
H2B_LIB=${KIT_ROOT}/bigfiles/libggml-cuda-h2b.so
DEPLOYED_LIB=/home/guile/llama-experiments/ollama-v100/lib/ollama/cuda_v12/libggml-cuda.so

# --- Toolchain (référence : gcc 13.4 + nvcc 12.6.85 + cmake 3.31.6 + go 1.26) --
TOOLS_ROOT=/home/guile/llama-experiments/tools
CMAKE_BIN=${TOOLS_ROOT}/cmake/bin/cmake
GCC_BIN=${TOOLS_ROOT}/gcc-13-bin/gcc
GXX_BIN=${TOOLS_ROOT}/gcc-13-bin/g++
CUDA_HOME=${TOOLS_ROOT}/cuda-12.6/usr/local/cuda-12.6
NVCC_BIN=${CUDA_HOME}/bin/nvcc
GO_BIN=/usr/bin/go
# Nsight Compute 2024.1.1 (pour les mesures NCU de e2/)
NCU_BIN=/home/guile/ncu-2024.1.1/usr/lib/nsight-compute/ncu

# --- Fork / build isolé (e2) ---------------------------------------------------
# Le kit ne contient PAS le fork complet (licence + poids). Il contient :
#   - la source de référence fattn-q8-volta.cuh (md5 36f564e2)
#   - les patches H2 / H2b (h2/patch-*.patch)
#   - les .o recompilés + .rsp (liste des 145 objets du build prod)
# Pour re-basculer H2b : appliquer h2/patch-h2b-*.patch sur le fork,
# recompiler fattn.cu avec la commande de compile_h2.sh, re-linker
# (link_*.sh + *.rsp). Cf. docs/protocols/03-build-lib-h2.md.
FORK_SRC=${KIT_ROOT}/../v100-repro/work/llama-volta-merged   # (machine de ref.)
E2_BUILD_DIR=${KIT_ROOT}/h2/e2-src/h2lib
